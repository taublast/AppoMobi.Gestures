<Project Sdk="Microsoft.NET.Sdk.Razor">

	<Import Project="..\NuGet.props" />

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
        <Title>AppoMobi.Blazor.Gestures</Title>
		<Description>Blazor implementation of AppoMobi.Gestures - pointer, touch and wheel gesture handling via JS interop</Description>
		<PackageTags>blazor gestures touch pointer wheel</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.5" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AppoMobi.Gestures\AppoMobi.Gestures.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
